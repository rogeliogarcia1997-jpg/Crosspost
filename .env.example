# Copy to .env for local development. Placeholders only — never commit real values.
# In production, inject these through your platform's secret manager.

# --- Core ---------------------------------------------------------------
APP_ENV=development                     # development | test | production
APP_NAME=Crosspost
PUBLIC_BASE_URL=http://localhost:8000   # https://... in production (used in tracked links)
SECRET_KEY=change-me                    # 32+ random chars: python -c "import secrets;print(secrets.token_urlsafe(48))"
TOKEN_ENCRYPTION_KEY=                   # Fernet key: python -m crosspost.cli generate-key
IP_HASH_SALT=change-me                  # random string; IPs are stored only as salted hashes
DATABASE_URL=sqlite:///./data/local/crosspost.db   # postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME in production
LOG_LEVEL=INFO
LOG_FORMAT=json                         # json | text
SENTRY_DSN=                             # optional; requires `pip install sentry-sdk`
SESSION_COOKIE_SECURE=false             # true in production (HTTPS only)

# --- MLS ------------------------------------------------------------------
MLS_PROVIDER=mock                       # mock | reso
MLS_MOCK_FEED_PATH=data/mock_mls_feed.json
MLS_SYNC_INTERVAL_MINUTES=15
MLS_NAME=Your MLS
MLS_DISCLAIMER=Information deemed reliable but not guaranteed.
RESO_BASE_URL=                          # e.g. https://api.your-mls-vendor.com/reso/odata
RESO_RESOURCE=Property
RESO_EXPAND=Media,OpenHouse             # leave empty if the server does not support $expand
RESO_TOKEN_URL=                         # OAuth2 client-credentials token endpoint
RESO_CLIENT_ID=
RESO_CLIENT_SECRET=
RESO_ACCESS_TOKEN=                      # alternative to client credentials (static bearer token)
RESO_SCOPE=
RESO_PAGE_SIZE=200
RESO_EXTRA_FILTER=                      # e.g. ListOfficeMlsId eq 'OFF100'

# --- Marketing authorization & attribution ------------------------------------
MARKETING_SCOPE=own_office              # own_office | own_agent | flagged
BROKERAGE_OFFICE_IDS=                   # comma-separated MLS office IDs, e.g. OFF100
BROKERAGE_AGENT_IDS=
BROKERAGE_NAME=
BROKERAGE_PHONE=
BROKERAGE_LICENSE=
POST_ATTRIBUTION_SUFFIX=                # extra disclosure appended to every post
PHOTOS_PER_POST=4
DISPLAY_TIMEZONE=America/Chicago

# --- Publishing defaults (editable later in Settings) --------------------------
PUBLISH_MODE_NEW_LISTING=manual_approval   # immediate | scheduled | manual_approval
PUBLISH_DELAY_MINUTES=0
ANNOUNCE_PRICE_REDUCTIONS=true
ANNOUNCE_OPEN_HOUSES=true
OPEN_HOUSE_LEAD_HOURS=48
ANNOUNCE_STATUS_CHANGES=false
REPOST_INTERVAL_DAYS=0
DELETE_POSTS_ON_UNAVAILABLE=false
ENABLED_PLATFORMS=test                  # comma-separated: test,facebook,instagram,linkedin,x,pinterest,threads,webhook,manual

# --- Leads & privacy -----------------------------------------------------------
LEAD_NOTIFICATION_EMAILS=               # comma-separated recipients for new-lead emails
LEAD_RATE_LIMIT_PER_10MIN=5
LEAD_FORM_MIN_SECONDS=3
LEAD_RETENTION_DAYS=0                   # 0 = keep until erased; otherwise purge inquiries older than N days
PRIVACY_CONTACT_EMAIL=

# --- Email -------------------------------------------------------------------
EMAIL_BACKEND=console                   # console | smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=no-reply@example.com

# --- CRM ---------------------------------------------------------------------
CRM_PROVIDER=none                       # none | webhook | followupboss
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
FOLLOWUPBOSS_API_KEY=
FOLLOWUPBOSS_SYSTEM=Crosspost
FOLLOWUPBOSS_SYSTEM_KEY=

# --- Social platform apps (OAuth client credentials) ------------------------------
SOCIAL_REQUEST_TIMEOUT_SECONDS=20
META_APP_ID=                            # Facebook Pages, Instagram, Threads
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202409
X_CLIENT_ID=
X_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
SOCIAL_WEBHOOK_URL=                     # default destination for the "webhook" adapter
SOCIAL_WEBHOOK_SECRET=

# --- Worker --------------------------------------------------------------------
WORKER_POLL_SECONDS=2
JOB_LOCK_TIMEOUT_SECONDS=600
JOB_MAX_ATTEMPTS=6
JOB_BACKOFF_BASE_SECONDS=30
JOB_BACKOFF_MAX_SECONDS=3600
POSTGRES_PASSWORD=change-me              # docker-compose only
